---
/**
 * Art-directed <picture>: a different crop for mobile vs desktop, each with
 * AVIF + WebP srcsets generated by astro:assets. Intended for above-the-fold heroes.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  desktop: ImageMetadata;
  mobile: ImageMetadata;
  alt: string;
  /** Media query at which the desktop crop takes over. */
  breakpoint?: string;
  desktopWidths?: number[];
  mobileWidths?: number[];
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const {
  desktop,
  mobile,
  alt,
  breakpoint = '(min-width: 760px)',
  desktopWidths = [960, 1440, 1920, 2400],
  mobileWidths = [420, 640, 860, 1080],
  sizes = '100vw',
  eager = true,
  class: className,
} = Astro.props;

async function srcset(src: ImageMetadata, widths: number[], format: 'avif' | 'webp') {
  const usable = widths.filter((w) => w <= src.width);
  const list = usable.length ? usable : [src.width];
  const imgs = await Promise.all(list.map((width) => getImage({ src, width, format, quality: format === 'avif' ? 60 : 78 })));
  return imgs.map((img, i) => `${img.src} ${list[i]}w`).join(', ');
}

const [dAvif, dWebp, mAvif, mWebp] = await Promise.all([
  srcset(desktop, desktopWidths, 'avif'),
  srcset(desktop, desktopWidths, 'webp'),
  srcset(mobile, mobileWidths, 'avif'),
  srcset(mobile, mobileWidths, 'webp'),
]);
const fallback = await getImage({ src: mobile, width: Math.min(860, mobile.width), format: 'webp', quality: 78 });
---

<picture class={className}>
  <source media={breakpoint} type="image/avif" srcset={dAvif} sizes={sizes} width={desktop.width} height={desktop.height} />
  <source media={breakpoint} type="image/webp" srcset={dWebp} sizes={sizes} width={desktop.width} height={desktop.height} />
  <source type="image/avif" srcset={mAvif} sizes={sizes} width={mobile.width} height={mobile.height} />
  <source type="image/webp" srcset={mWebp} sizes={sizes} width={mobile.width} height={mobile.height} />
  <img
    src={fallback.src}
    alt={alt}
    width={mobile.width}
    height={mobile.height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding={eager ? 'sync' : 'async'}
  />
</picture>
