---
interface Props {
  class?: string;
  compact?: boolean;
}
const { class: className, compact = false } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo-mark" viewBox="0 0 40 40" width="34" height="34" aria-hidden="true" focusable="false">
    <rect width="40" height="40" rx="9" fill="#0B1220"></rect>
    <rect x="0.5" y="0.5" width="39" height="39" rx="8.5" fill="none" stroke="rgb(255 255 255 / 0.14)"></rect>
    <path d="M10 11.5 L19 20 L10 28.5" fill="none" stroke="#FF5A1F" stroke-width="4.6" stroke-linecap="square"></path>
    <path d="M20 11.5 L29 20 L20 28.5" fill="none" stroke="#FF5A1F" stroke-width="4.6" stroke-linecap="square" opacity="0.55"></path>
  </svg>
  {
    !compact && (
      <span class="logo-word">
        Upgrade <span class="logo-my">My</span> Run
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    line-height: 1;
  }
  .logo-mark {
    flex: none;
  }
  .logo-word {
    font-family: var(--font-display);
    font-size: 1.32rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink);
    padding-top: 0.08em;
  }
  .logo-my {
    color: var(--accent);
  }
</style>
