---
interface Props {
  specs: { label: string; value: string }[];
  title: string;
}
const { specs, title } = Astro.props;
---

{
  specs.length > 0 && (
    <section class="specs" aria-labelledby="specs-title">
      <h2 id="specs-title" class="display">Specs</h2>
      <table>
        <caption class="sr-only">{title}</caption>
        <tbody>
          {specs.map((s) => (
            <tr>
              <th scope="row">{s.label}</th>
              <td>{s.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )
}

<style>
  h2 {
    font-size: var(--step-3);
    margin-bottom: 1.25rem;
  }
  table {
    width: 100%;
    border-top: 2px solid var(--ink);
    font-size: 0.95rem;
  }
  tr {
    border-bottom: 1px solid var(--rule);
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.85rem 0;
  }
  th {
    width: 38%;
    padding-right: 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding-top: 1rem;
  }
  td {
    font-weight: 550;
  }
</style>
