---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Breadcrumb from './Breadcrumb.astro';

interface Props {
  title: string;
  kicker?: string;
  lede?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  crumbs?: { name: string; url: string }[];
  size?: 'tall' | 'medium';
}
const { title, kicker, lede, image, imageAlt = '', crumbs, size = 'medium' } = Astro.props;
---

{
  image ? (
    <section class:list={['ph ph--image grain', `ph--${size}`]}>
      <div class="ph-media">
        <Image
          src={image}
          alt={imageAlt}
          widths={[640, 960, 1440, 1920, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="container ph-inner">
        {crumbs && <Breadcrumb items={crumbs} />}
        {kicker && <p class="kicker ph-kicker">{kicker}</p>}
        <h1 class="display ph-title">{title}</h1>
        {lede && <p class="ph-lede">{lede}</p>}
        <slot />
      </div>
    </section>
  ) : (
    <section class="ph ph--type">
      <div class="container ph-inner">
        {crumbs && <Breadcrumb items={crumbs} />}
        {kicker && <p class="kicker">{kicker}</p>}
        <h1 class="display ph-title">{title}</h1>
        {lede && <p class="ph-lede">{lede}</p>}
        <slot />
      </div>
    </section>
  )
}

<style>
  .ph--image {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(380px, 52vw, 640px);
    color: #fff;
    overflow: hidden;
    background: var(--navy-950);
  }
  .ph--tall {
    min-height: clamp(460px, 62vw, 760px);
  }
  .ph-media {
    position: absolute;
    inset: 0;
  }
  .ph-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ph--image::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(0deg, rgb(7 12 22 / 0.95) 0%, rgb(7 12 22 / 0.55) 40%, rgb(7 12 22 / 0.1) 75%),
      linear-gradient(90deg, rgb(7 12 22 / 0.5), transparent 60%);
  }
  .ph-inner {
    position: relative;
    z-index: 3;
    padding-block: var(--space-2xl) clamp(2rem, 4vw, 3.5rem);
  }
  .ph--image :global(.breadcrumb ol) {
    color: rgb(255 255 255 / 0.75);
  }
  .ph--image :global(.breadcrumb a:hover) {
    color: #fff;
  }
  .ph-kicker {
    color: #ff7a47;
  }
  .ph-inner > * + * {
    margin-top: 1rem;
  }
  .ph-title {
    font-size: var(--step-5);
    line-height: 0.88;
    max-width: 14ch;
  }
  .ph--type .ph-title {
    max-width: none;
  }
  .ph-lede {
    max-width: 40rem;
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.4rem);
    line-height: 1.5;
  }
  .ph--image .ph-lede {
    color: rgb(255 255 255 / 0.88);
  }
  .ph--type {
    border-bottom: 1px solid var(--rule);
  }
  .ph--type .ph-lede {
    color: var(--ink-soft);
  }
  /* Mobile: image shown as a clear 4:3 photo that fades into navy; copy sits
     below it (only overlapping the faded edge), never over the subject. */
  @media (max-width: 700px) {
    .ph--image,
    .ph--tall {
      display: block;
      min-height: 0;
    }
    .ph--image::before {
      display: none;
    }
    .ph-media {
      position: relative;
      aspect-ratio: 4 / 3;
    }
    .ph-media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgb(7 12 22 / 0) 55%, rgb(7 12 22 / 0.8) 85%, var(--navy-950) 100%);
    }
    .ph--image .ph-inner {
      margin-top: -2.5rem;
      padding-top: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .ph-media :global(img) {
      animation: ph-settle 2.2s var(--ease-out) both;
    }
    @supports (animation-timeline: scroll()) {
      .ph-media {
        animation: ph-parallax linear both;
        animation-timeline: scroll(root);
        animation-range: 0 80vh;
      }
    }
  }
  @media (max-width: 700px) {
    .ph--image .ph-media {
      animation: none !important;
    }
  }
  @keyframes ph-settle {
    from {
      transform: scale(1.07);
    }
  }
  @keyframes ph-parallax {
    to {
      transform: translateY(15%);
    }
  }
</style>
