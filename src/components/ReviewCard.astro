---
import { Image } from 'astro:assets';
import ScoreBadge from './ScoreBadge.astro';
import { CATEGORIES } from '../data/categories';
import { formatDate, formatPrice, reviewUrl, type Review } from '../lib/content';

interface Props {
  review: Review;
  variant?: 'feature' | 'card' | 'row';
  headingLevel?: 'h2' | 'h3';
  sizes?: string;
  eager?: boolean;
  index?: number;
}
const { review, variant = 'card', headingLevel = 'h3', sizes, eager = false, index } = Astro.props;
const { data } = review;
const Heading = headingLevel;
const cat = CATEGORIES[data.category];
const widths = variant === 'row' ? [320, 480, 640] : [480, 720, 960, 1280, 1600];
const defaultSizes =
  variant === 'feature'
    ? '(min-width: 1100px) 60vw, 100vw'
    : variant === 'row'
      ? '(min-width: 760px) 240px, 34vw'
      : '(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw';
---

<article class:list={['rc', `rc--${variant}`]} data-reveal>
  <a href={reviewUrl(review.id)} class="rc-link">
    <div class="rc-media zoom grain">
      <Image
        src={data.heroImage}
        alt={data.heroAlt}
        widths={widths}
        sizes={sizes ?? defaultSizes}
        loading={eager ? 'eager' : 'lazy'}
        layout="none"
        class="rc-img"
      />
      {variant !== 'row' && <ScoreBadge rating={data.rating} size={variant === 'feature' ? 'md' : 'sm'} class="rc-score" />}
    </div>
    <div class="rc-body">
      <div class="rc-meta">
        {typeof index === 'number' && <span class="rc-index">{String(index + 1).padStart(2, '0')}</span>}
        <span class="kicker kicker--plain">{cat.shortName}</span>
        {data.sample && <span class="sample-badge">Sample</span>}
      </div>
      <Heading class:list={['rc-title', variant !== 'row' && 'display']}>{data.title}</Heading>
      {variant !== 'row' && <p class="rc-desc">{data.description}</p>}
      <p class="rc-foot">
        {variant === 'row' && <span class="rc-rating">{data.rating.toFixed(1)}<span>/10</span></span>}
        <span>{formatPrice(data.price)}</span>
        <span aria-hidden="true">·</span>
        <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
      </p>
    </div>
  </a>
</article>

<style>
  .rc {
    position: relative;
    height: 100%;
  }
  .rc-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .rc-media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: var(--navy-800);
  }
  .rc-media :global(.rc-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rc-media :global(.rc-score) {
    position: absolute;
    z-index: 3;
    right: 0.9rem;
    bottom: 0.9rem;
  }
  .rc-body {
    padding-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .rc-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .rc-index {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--ink-mute);
  }
  .rc-title {
    font-size: clamp(1.45rem, 1.2rem + 0.7vw, 1.85rem);
    line-height: 0.98;
    transition: color 0.2s;
  }
  .rc-link:hover .rc-title {
    color: var(--accent-ink);
  }
  .rc-desc {
    color: var(--ink-soft);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .rc-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
    margin-top: auto;
    padding-top: 0.25rem;
  }

  /* Feature: big product image that fades into a navy panel carrying the copy.
     Copy never sits on top of the product itself. */
  .rc--feature .rc-link {
    position: relative;
    background: var(--navy-950);
    border-radius: var(--radius);
    overflow: hidden;
    color: #fff;
  }
  .rc--feature .rc-media {
    aspect-ratio: 4 / 3;
    border-radius: 0;
  }
  .rc--feature .rc-media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgb(7 12 22 / 0) 62%, rgb(7 12 22 / 0.7) 86%, var(--navy-950) 100%);
  }
  .rc--feature .rc-media :global(.rc-score) {
    top: 1.25rem;
    right: 1.25rem;
    bottom: auto;
  }
  .rc--feature .rc-body {
    position: relative;
    z-index: 3;
    margin-top: -1.5rem;
    padding: 0 clamp(1.25rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .rc--feature .kicker {
    color: #ff7a47;
  }
  .rc--feature .rc-title {
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem);
    max-width: 20ch;
  }
  .rc--feature .rc-link:hover .rc-title {
    color: #fff;
  }
  .rc--feature .rc-desc {
    color: rgb(255 255 255 / 0.82);
    font-size: 1.02rem;
    max-width: 42rem;
  }
  .rc--feature .rc-foot,
  .rc--feature .rc-index {
    color: rgb(255 255 255 / 0.7);
  }
  .rc--feature .sample-badge {
    color: rgb(255 255 255 / 0.75);
    border-color: rgb(255 255 255 / 0.4);
  }
  @media (max-width: 600px) {
    .rc--feature .rc-body {
      margin-top: -0.5rem;
    }
    .rc--feature .rc-desc {
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }
  }

  /* Row: compact horizontal list item */
  .rc--row .rc-link {
    display: grid;
    grid-template-columns: clamp(110px, 30vw, 240px) 1fr;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: center;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .rc--row .rc-body {
    padding-top: 0;
  }
  .rc--row .rc-title {
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  @media (max-width: 600px) {
    .rc--row .rc-foot > span[aria-hidden='true'] {
      display: none;
    }
    .rc--row .rc-foot time {
      flex-basis: 100%;
    }
  }
  .rc-rating {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--accent-ink);
    letter-spacing: 0.02em;
    margin-right: 0.35rem;
  }
  .rc-rating span {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: var(--ink-mute);
  }
</style>
