---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import hero from '../assets/images/hero.webp';
import { CATEGORY_LIST } from '../data/categories';
---

<BaseLayout title="Page not found" description="This page took a wrong turn. Head back to the reviews." noindex>
  <section class="nf grain" aria-labelledby="nf-title">
    <div class="nf-media" aria-hidden="true">
      <Image src={hero} alt="" widths={[960, 1440, 2400]} sizes="100vw" loading="eager" />
    </div>
    <div class="container nf-inner">
      <p class="kicker nf-kicker">Error 404 · Off course</p>
      <h1 id="nf-title" class="display nf-title">
        <span class="nf-num" aria-hidden="true">404</span>
        <span class="nf-head">Wrong turn<br />at mile&nbsp;four.</span>
      </h1>
      <p class="nf-sub">
        The page you’re looking for has moved, retired, or never made it to the start line. Let’s get you back on route.
      </p>
      <div class="nf-ctas">
        <a href="/" class="btn btn--primary">Back to home</a>
        <a href="/reviews/" class="btn btn--on-image">Browse reviews</a>
      </div>
      <ul class="nf-cats" role="list">
        {
          CATEGORY_LIST.map((c) => (
            <li>
              <a href={`/${c.slug}/`}>{c.shortName}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    color: #fff;
    background: var(--navy-950);
    overflow: hidden;
  }
  .nf-media {
    position: absolute;
    inset: 0;
    opacity: 0.55;
  }
  .nf-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% 50%;
    filter: saturate(0.7);
  }
  .nf::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgb(7 12 22 / 0.95) 0%, rgb(7 12 22 / 0.7) 45%, rgb(7 12 22 / 0.2) 100%);
  }
  .nf-inner {
    position: relative;
    z-index: 3;
    padding-block: var(--space-2xl);
  }
  .nf-kicker {
    color: #ff7a47;
  }
  .nf-title {
    margin-top: 1rem;
    display: grid;
  }
  .nf-num {
    font-size: clamp(7rem, 4rem + 18vw, 20rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 2px var(--orange-500);
  }
  .nf-head {
    margin-top: 0.5rem;
    font-size: clamp(2.4rem, 1.5rem + 4vw, 5rem);
  }
  .nf-sub {
    margin-top: 1.5rem;
    max-width: 32rem;
    color: rgb(255 255 255 / 0.85);
  }
  .nf-ctas {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .nf-cats {
    list-style: none;
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .nf-cats a {
    color: rgb(255 255 255 / 0.75);
    text-decoration: none;
  }
  .nf-cats a:hover {
    color: #ff7a47;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nf-num {
      animation: nf-in 1.2s var(--ease-out) both;
    }
  }
  @keyframes nf-in {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
  }
</style>
